# Copy to .env and fill in. .env is gitignored: never commit real values.

# "mock" (default) runs with no chain and no credentials. "web3" talks to a real node.
SECUREFLOW_BACKEND=mock

# --- web3 backend -------------------------------------------------------------

# JSON-RPC endpoint. Anvil/Hardhat default is 8545; Ganache GUI is 7545.
ETH_RPC_URL=http://127.0.0.1:8545

# Key that signs attestations. Use a THROWAWAY testnet/dev key, never one holding real funds.
ETH_PRIVATE_KEY=

# Either set the contract address directly...
CONTRACT_ADDRESS=
# ...or leave it blank and point at the file `python -m secureflow.deploy` writes.
SECUREFLOW_DEPLOYMENT_FILE=deployments/local.json

# --- auth ---------------------------------------------------------------------

# Required with the web3 backend. Comma-separated name:sha256hex pairs; the raw keys are never stored.
# Generate one with: python -m secureflow.auth <client-name>
SECUREFLOW_API_KEYS=

# --- index / storage ----------------------------------------------------------

# SQLite file for the event index and idempotency records. ":memory:" rebuilds on every start.
SECUREFLOW_DB=:memory:
# Blocks to wait before indexing (reorg safety). 0 for local chains; ~12 on mainnet/testnets.
SECUREFLOW_INDEX_CONFIRMATIONS=0
# Max blocks per eth_getLogs call while syncing. Lower it if your RPC provider complains.
SECUREFLOW_INDEX_CHUNK=2000

# --- logging ------------------------------------------------------------------

SECUREFLOW_LOG_LEVEL=INFO
SECUREFLOW_LOG_FORMAT=json

# --- encryption (optional, any backend) ---------------------------------------

# 32 random bytes, base64. Generate with: python -m secureflow.crypto
# Enables {"encrypt": true} on POST /attestations. Keep it: losing it makes
# every encrypted attestation unreadable.
SECUREFLOW_ENCRYPTION_KEY=
