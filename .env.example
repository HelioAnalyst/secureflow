# Copy to .env and fill in. .env is gitignored: never commit real values.

# "mock" (default) runs with no chain and no credentials. "web3" talks to a real node.
SECUREFLOW_BACKEND=mock

# --- web3 backend -------------------------------------------------------------

# JSON-RPC endpoint. Anvil/Hardhat default is 8545; Ganache GUI is 7545.
ETH_RPC_URL=http://127.0.0.1:8545

# Key that signs attestations. Use a THROWAWAY testnet/dev key, never one holding real funds.
ETH_PRIVATE_KEY=

# Either set the contract address directly...
CONTRACT_ADDRESS=
# ...or leave it blank and point at the file `python -m secureflow.deploy` writes.
SECUREFLOW_DEPLOYMENT_FILE=deployments/local.json

# --- encryption (optional, any backend) ---------------------------------------

# 32 random bytes, base64. Generate with: python -m secureflow.crypto
# Enables {"encrypt": true} on POST /attestations. Keep it: losing it makes
# every encrypted attestation unreadable.
SECUREFLOW_ENCRYPTION_KEY=
